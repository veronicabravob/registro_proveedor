{
  "name": "registro-proveedor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional \"Registro como Proveedor\" — Reto 01 Periferia IT Group",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "demo": "tsx demo.ts",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w backend && npm run test -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "modulo": "npm run modulo -w backend",
    "modulo:check": "npm run modulo:check -w backend"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
