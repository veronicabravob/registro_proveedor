# ── Modelo de lenguaje ────────────────────────────────────────────────────────
# La clave vive SOLO en el entorno del backend: nunca en el repo, el front ni los logs.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=90000
# Fallback del servidor ante rechazos de clasificadores (modelos Claude 5.x)
LLM_FALLBACKS=true
ANTHROPIC_API_KEY=

# ── Límites de costo y robustez ──────────────────────────────────────────────
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=400000
# Tope GLOBAL de tokens por día (UTC) sumando todas las sesiones: crear sesiones nuevas no evade
# el límite de costo. Al alcanzarlo el chat lo informa y se reinicia a las 00:00 UTC.
MAX_TOKENS_PER_DAY=3000000
MAX_SESSIONS=200
SESSION_TTL_MINUTES=120
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_PER_MINUTE=20
# Proxies de confianza delante del servidor (Render = 1). La IP para el límite por minuto se toma de
# x-forwarded-for contando desde el final (el valor que agrega el proxy, no el que envía el cliente).
# 0 = no confiar en x-forwarded-for (todas las solicitudes comparten un único límite).
TRUSTED_PROXIES=1

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
# Opcional: si se define, el front y la API piden esta clave de acceso.
APP_ACCESS_KEY=
# Opcional: fija la fecha de evaluación de vigencias (YYYY-MM-DD). Por defecto, hoy.
FECHA_EJECUCION=

# ── Observabilidad (opcional) ────────────────────────────────────────────────
# Trazas del agente a Langfuse vía OpenTelemetry. Sin claves, queda apagada.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OTEL_SERVICE_NAME=registro-proveedor
# metadata_only (por defecto) | content: incluye mensajes y respuestas en las trazas (enmascarados)
TELEMETRY_CONTENT_MODE=metadata_only
# Trazas y métricas a cualquier backend OTLP/HTTP (Grafana Cloud, Honeycomb, un Collector…)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
METRICS_EXPORT_INTERVAL_MS=30000
# true: imprime las métricas en consola (útil en local)
METRICS_CONSOLE=false
